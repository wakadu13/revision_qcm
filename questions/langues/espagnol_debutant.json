      "explication": "Verbes en -ar : -o, -as, -a, -amos, -áis, -an."
    },
    {
      "id": "es-hablar-pret",
      "verbe": "hablar",
      "traduction": "parler",
      "temps": "pretérito indefinido",
      "formes": {
        "yo": "hablé",
        "tú": "hablaste",
        "él / ella / usted": "habló",
        "nosotros": "hablamos",
        "vosotros": "hablasteis",
        "ellos / ellas / ustedes": "hablaron"

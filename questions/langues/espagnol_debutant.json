  "grammaire": [
    {
      "id": "es-trou-001",
      "type": "TROU",
      "question": "Yo ___ (ser) estudiante.",
      "reponses_texte": [
        "soy"
      ],
      "explication": "Identité / profession → ser."
    },
    {
      "id": "es-trou-002",
      "type": "TROU",
      "question": "Mi madre ___ (estar) en casa.",
      "reponses_texte": [
        "está"
      ],
      "explication": "Localisation → estar."
    },
    {
      "id": "es-trou-003",
      "type": "TROU",
      "question": "Ayer nosotros ___ (hablar) con Juan.",
      "reponses_texte": [
        "hablamos"
      ],
      "explication": "« ayer » → pretérito indefinido ; même forme qu'au présent pour « nosotros »."
    },
    {
      "id": "es-qcm-001",
      "type": "QCM",
      "question": "« La sopa ___ fría. » (La soupe est froide.)",
      "choix": [
        "es",
        "está"
      ],
      "reponses": [
        1
      ],
      "explication": "État passager → estar."
    },
    {
      "id": "es-ordre-001",

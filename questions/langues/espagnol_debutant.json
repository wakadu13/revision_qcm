        "nosotros": "tenemos",
        "vosotros": "tenéis",
        "ellos / ellas / ustedes": "tienen"
      }
    },
    {
      "id": "es-hablar-pres",
      "verbe": "hablar",
      "traduction": "parler",
      "temps": "presente",
      "formes": {
        "yo": "hablo",
        "tú": "hablas",
        "él / ella / usted": "habla",
        "nosotros": "hablamos",
        "vosotros": "habláis",
        "ellos / ellas / ustedes": "hablan"
